# === SUNO_server — .gitignore ===
# Cubre server/ (Django), infra/ (Docker) y artefactos de calidad y DAST.

# --- Python / Django (server/) ---
server/**/__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
server/staticfiles/
server/media/
# Raíz del adaptador `LocalFsBlobStore` (ADR-007, Paso 17): adjuntos de
# desarrollo depositados en el filesystem. Nunca se versionan.
server/.blobstore/
*.sqlite3
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Secretos ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# --- Docker / infra ---
infra/**/volumes/
infra/**/data/
*.log

# --- Editores / SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Artefactos de calidad / DAST (CI y local) ---
.coverage
coverage*.xml
.schemathesis/
reports/
zap/

# Simulacro de backup en CI (.github/workflows/backup.yml)
.ci-backups/
age-identity.txt
wrong-identity.txt
# CI del monitoreo (.github/workflows/monitoring.yml)
.ci-ca-bundle.crt
rendered/

.deploy-state
